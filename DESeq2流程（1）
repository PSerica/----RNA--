analyze_highly_variable_genes <- function() {
  cat("正在分析高变异基因...\n")
  species_means <- t(apply(counts(dds, normalized = TRUE), 1, 
                           function(x) tapply(x, colData(dds)$species, mean)))
  gene_variance_cv <- apply(species_means, 1, function(x) {
    if(mean(x) == 0) return(0)
    sd(x) / mean(x)
  })
  gene_variance_all <- apply(counts(dds, normalized = TRUE), 1, function(x) {
    if(mean(x) == 0) return(0)
    sd(x) / mean(x)
  })
  gene_variance_cv <- gene_variance_cv[is.finite(gene_variance_cv) & !is.na(gene_variance_cv)]
  gene_variance_all <- gene_variance_all[is.finite(gene_variance_all) & !is.na(gene_variance_all)]
  top_50_hvg_cv <- names(sort(gene_variance_cv, decreasing = TRUE))[1:50]
  top_50_hvg_all <- names(sort(gene_variance_all, decreasing = TRUE))[1:50]
  top_hvg_union <- unique(c(top_50_hvg_cv, top_50_hvg_all))
  cat(sprintf("  筛选出 %d 个高变异基因\n", length(top_hvg_union)))
  top_variable_counts <- counts(dds, normalized = TRUE)[top_hvg_union, ]
  high_var_genes_df <- data.frame(
    GeneID = top_hvg_union,
    CV_Species = gene_variance_cv[top_hvg_union],
    CV_All = gene_variance_all[top_hvg_union],
    CV_Rank_Species = match(top_hvg_union, names(sort(gene_variance_cv, decreasing = TRUE))),
    CV_Rank_All = match(top_hvg_union, names(sort(gene_variance_all, decreasing = TRUE)))
  )
  high_var_genes_df <- high_var_genes_df[order(-high_var_genes_df$CV_Species), ]
  write.csv(high_var_genes_df, "Highly_Variable_Genes_Detailed.csv", row.names = FALSE)
  write.csv(data.frame(GeneID = top_hvg_union), "Highly_Variable_Genes_Simple.csv", row.names = FALSE)
  hvg_conserved_overlap <- intersect(top_hvg_union, conserved_genes_results$at_least_three)
  cat(sprintf("  高变异基因与保守基因重叠数: %d (%.1f%%)\n",
              length(hvg_conserved_overlap),
              length(hvg_conserved_overlap) / length(top_hvg_union) * 100))
  return(list(
    genes = top_hvg_union,
    counts = top_variable_counts,
    variance_cv = gene_variance_cv,
    variance_all = gene_variance_all,
    details = high_var_genes_df,
    conserved_overlap = hvg_conserved_overlap
  ))
}
