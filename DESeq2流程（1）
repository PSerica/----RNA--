plot_top_genes_enhanced <- function(gene_counts, species_involved, title, max_genes = 6) {
  if(is.null(gene_counts) || nrow(gene_counts) == 0) {
    cat("  跳过: 没有可用的基因表达数据\n")
    return(NULL)
  }
  # 筛选相关物种的样本
  samples_to_keep <- colData(dds)$species %in% species_involved
  if(sum(samples_to_keep) == 0) {
    cat("  跳过: 没有找到对应的物种样本\n")
    return(NULL)
  }
  # 取前N个基因进行可视化（避免图表过于拥挤）
  genes_to_show <- min(max_genes, nrow(gene_counts))
  gene_counts_filtered <- gene_counts[1:genes_to_show, samples_to_keep]
  
  # 转换数据格式用于ggplot2
  plot_data <- melt(gene_counts_filtered)
  species_filtered <- colData(dds)$species[samples_to_keep]
  plot_data$species <- rep(species_filtered, each = nrow(gene_counts_filtered))
  # 确保物种因子水平正确排序（保持一致的显示顺序）
  plot_data$species <- factor(plot_data$species, 
                              levels = c("[Genus_species_B]", "[Genus_species_A]", "[Genus_species_C]"))
  # 定义物种颜色映射
  species_colors_custom <- c(
    "[Genus_species_C]" = "#F0A73A",    # [Species_C] - 橙黄色
    "[Genus_species_A]" = "#3ABF99",                # [Species_A] - 青绿色  
    "[Genus_species_B]" = "#2C91E0"           # [Species_B] - 钢蓝色
  )
  # 动态选择颜色：只包含当前图表中实际出现的物种
  # 意义：避免在颜色映射中出现不存在的物种，防止ggplot2警告
  present_species <- unique(plot_data$species)
  current_colors <- species_colors_custom[as.character(present_species)]
  # 绘制箱线图
  p <- ggplot(plot_data, aes(x = species, y = value, fill = species)) +
    geom_boxplot(alpha = 0.8) +
    geom_point(position = position_jitter(width = 0.2), size = 0.8, alpha = 0.6) +
    facet_wrap(~ Var1, scales = "free_y", ncol = 2) +
    theme_bw() +
    scale_fill_manual(values = current_colors) +  # 应用动态选择的颜色
    labs(title = title, 
         x = "Species", 
         y = "Normalized Expression",
         subtitle = sprintf("Top %d significant DEGs", genes_to_show)) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1),
          plot.title = element_text(face = "bold", size = 12),
          plot.subtitle = element_text(color = "gray40"),
          legend.position = "none")  # 移除图例，x轴已显示物种名称
  return(p)
}
