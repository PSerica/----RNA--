### 5. 结果整理与注释函数 ------------------------------------------------------
# 功能：整理和注释DESeq2结果（支持Wald检验和LRT检验）
# 意义：统一所有比较组的结果格式，便于后续分析和可视化
  ## 5.1 函数构建
  # 功能：整理和注释DESeq2结果（支持Wald检验和LRT检验）
organize_DESeq_results <- function(results_object, comparison_name, test_type = "wald") {
  if(test_type == "wald") {
    # 原有Wald检验处理逻辑
    res_df <- as.data.frame(results_object)
    res_df$gene_id <- rownames(res_df)
    res_df$comparison <- comparison_name
    res_df$test_type <- "wald"
  } else if(test_type == "lrt") {
    # LRT检验特殊处理 - 使用标准化后的结果
    res_df <- results_object  # 使用标准化后的结果
    res_df$comparison <- comparison_name
    res_df$test_type <- "lrt"
  }
  # 确保所有必需的列都存在
  required_cols <- c("gene_id", "comparison", "test_type", "log2FoldChange", "padj", 
                     "pvalue", "baseMean", "lfcSE", "stat")
  # 检查缺失的列
  missing_cols <- setdiff(required_cols, colnames(res_df))
  if(length(missing_cols) > 0) {
    cat("警告: 缺少列:", paste(missing_cols, collapse = ", "), "\n")
    # 为缺失的列添加NA值
    for(col in missing_cols) {
      res_df[[col]] <- NA
    }
  }
  # 更健壮的DE_status赋值（根据检验类型调整阈值）
  res_df$DE_status <- "NOT_SIG"
  if(test_type == "wald") {
    # Wald检验使用原有标准：显著且log2FC绝对值≥1
    significant <- !is.na(res_df$padj) & res_df$padj < 0.05
    large_fc <- abs(res_df$log2FoldChange) >= 1
    up_condition <- significant & large_fc & res_df$log2FoldChange > 0
    down_condition <- significant & large_fc & res_df$log2FoldChange < 0
  } else if(test_type == "lrt") {
    # LRT检验使用调整后的标准
    # 注意：LRT检验识别整体差异，不区分上下调方向
    significant <- !is.na(res_df$padj) & res_df$padj < 0.05
    # 使用变异程度作为替代标准（前25%的高变异基因）
    high_variation <- res_df$log2FoldChange > quantile(res_df$log2FoldChange, 0.75, na.rm=TRUE)
    up_condition <- significant & high_variation
    down_condition <- rep(FALSE, nrow(res_df))  # LRT不设下调基因
    # 对于LRT显著基因，统一标记为LRT_SIGNIFICANT
    res_df$DE_status[significant] <- "LRT_SIGNIFICANT"
  }
  # 设置上下调状态（仅对Wald检验有效）
  res_df$DE_status[up_condition] <- "UP"
  res_df$DE_status[down_condition] <- "DOWN"
  # 确保列顺序正确
  final_cols <- c("gene_id", "comparison", "test_type", "DE_status",
                  "log2FoldChange", "padj", "pvalue", 
                  "baseMean", "lfcSE", "stat")
  # 只保留存在的列
  existing_cols <- intersect(final_cols, colnames(res_df))
  res_df <- res_df[, existing_cols]
  # 按显著性排序：先按padj升序，再按log2FC绝对值降序
  res_df <- res_df[order(res_df$padj, -abs(res_df$log2FoldChange)), ]
  return(res_df)
}
