prepare_downstream_analysis_files <- function() {
  cat("正在为下游分析准备专用文件...\n")
  downstream_dirs <- c("GO_Analysis", "Pathway_Analysis", "Network_Analysis", "Visualization")
  for(dir in downstream_dirs) {
    if (!dir.exists(dir)) {
      dir.create(dir)
      cat("   创建目录:", dir, "/\n")
    }
  }
  cat(">>> 准备GO富集分析文件...\n")
  saveRDS(gene_lists, "GO_Analysis/All_Gene_Lists.rds")
  cat("   ✅ 完整基因列表对象: GO_Analysis/All_Gene_Lists.rds\n")
  comparisons <- names(gene_lists)
  for(comp in comparisons) {
    genes <- gene_lists[[comp]]
    if(length(genes) > 0) {
      gene_df <- data.frame(GeneID = genes)
      write.csv(gene_df, paste0("GO_Analysis/", comp, "_genes.csv"), row.names = FALSE)
    }
  }
  cat("   ✅ 各比较组基因列表文件已生成\n")
  cat(">>> 准备通路分析文件...\n")
  background_genes <- rownames(dds)
  write.csv(data.frame(GeneID = background_genes), "Pathway_Analysis/Background_Genes.csv", row.names = FALSE)
  cat("   ✅ 背景基因集: Pathway_Analysis/Background_Genes.csv\n")
  if(exists("conserved_genes_results")) {
    write.csv(data.frame(GeneID = conserved_genes_results$at_least_three), 
              "Pathway_Analysis/Conservative_DEGs.csv", row.names = FALSE)
    cat("   ✅ 保守差异基因列表: Pathway_Analysis/Conservative_DEGs.csv\n")
  }
  cat(">>> 准备共表达网络分析文件...\n")
  if(exists("high_var_genes")) {
    hvg_expression <- counts(dds, normalized = TRUE)[high_var_genes$genes, ]
    write.csv(hvg_expression, "Network_Analysis/High_Variable_Genes_Expression.csv")
    cat("   ✅ 高变异基因表达矩阵: Network_Analysis/High_Variable_Genes_Expression.csv\n")
  }
  sample_info_df <- as.data.frame(colData(dds))
  write.csv(sample_info_df, "Network_Analysis/Sample_Information.csv")
  cat("   ✅ 样本信息表: Network_Analysis/Sample_Information.csv\n")
}
prepare_downstream_analysis_files()

