cat(sprintf("前100个高变异基因变异系数范围: %.3f - %.3f\n",
            min(gene_variance[top_100_hvg]),
            max(gene_variance[top_100_hvg])))
cat(sprintf("前5000个高变异基因变异系数范围: %.3f - %.3f\n",
            min(gene_variance[top_5000_hvg]),
            max(gene_variance[top_5000_hvg])))
cat(sprintf("全基因组变异系数中位数: %.3f\n", median(gene_variance)))
cat(sprintf("统计阈值 (中位数 + 2×MAD): %.3f\n", variance_threshold))
        ## 4.3.2.2重叠分析统计
        # 功能：比较LRT显著基因与高变异基因的重叠情况
        # 意义：验证不同方法的一致性，识别高置信度差异基因
lrt_sig_genes <- rownames(results_three_group_lrt)[results_three_group_lrt$padj < 0.05 & !is.na(results_three_group_lrt$padj)]
