    A_vs_C = rownames(results_A_vs_C)[which(results_A_vs_C$padj < 0.05 & !is.na(results_A_vs_C$padj))],
    C_vs_B = rownames(results_C_vs_B)[which(results_C_vs_B$padj < 0.05 & !is.na(results_C_vs_B$padj))],
    C_vs_A = rownames(results_C_vs_A)[which(results_C_vs_A$padj < 0.05 & !is.na(results_C_vs_A$padj))],
    three_group = rownames(results_three_group_lrt)[which(results_three_group_lrt$padj < 0.05 & !is.na(results_three_group_lrt$padj))]
  )
  cat("\n>>> 各比较组显著基因数量统计:\n")
  for (name in names(sig_genes_list)) {
    cat(sprintf("  %-25s: %5d 个显著基因\n", name, length(sig_genes_list[[name]])))
  }
  cat("\n>>> 保守性分析:\n")
  common_all_comparisons <- Reduce(intersect, sig_genes_list)
  cat(sprintf("  在所有7个比较中都显著的基因: %d 个 (最高保守性)\n", length(common_all_comparisons)))
  gene_frequency <- table(unlist(sig_genes_list))
  common_at_least_four <- names(gene_frequency[gene_frequency >= 4])
  cat(sprintf("  在至少4个比较中显著的基因: %d 个 (高保守性)\n", length(common_at_least_four)))
  common_at_least_three <- names(gene_frequency[gene_frequency >= 3])
  cat(sprintf("  在至少3个比较中显著的基因: %d 个 (中等保守性)\n", length(common_at_least_three)))
  all_sig_genes <- unique(unlist(sig_genes_list))
  cat(sprintf("  所有显著基因的并集: %d 个唯一基因\n", length(all_sig_genes)))
  if (length(common_all_comparisons) > 0) {
    write.csv(data.frame(GeneID = common_all_comparisons, Conservation_Level = "All_7_Comparisons"), 
              "Conservative_Genes_All_Comparisons.csv", row.names = FALSE)
  }
  if (length(common_at_least_four) > 0) {
    write.csv(data.frame(GeneID = common_at_least_four, Frequency = as.numeric(gene_frequency[common_at_least_four]), Conservation_Level = "At_Least_4_Comparisons"), 
              "Conservative_Genes_High_Frequency.csv", row.names = FALSE)
  }
  if (length(common_at_least_three) > 0) {
    write.csv(data.frame(GeneID = common_at_least_three, Frequency = as.numeric(gene_frequency[common_at_least_three]), Conservation_Level = "At_Least_3_Comparisons"), 
              "Conservative_Genes_Medium_Frequency.csv", row.names = FALSE)
  }
  conservation_summary <- data.frame(
    Conservation_Level = c("All_7", "At_Least_4", "At_Least_3", "All_Significant"),
    Gene_Count = c(length(common_all_comparisons), length(common_at_least_four), 
                   length(common_at_least_three), length(all_sig_genes)),
    Percentage_Of_All = round(c(
      length(common_all_comparisons) / length(all_sig_genes) * 100,
      length(common_at_least_four) / length(all_sig_genes) * 100,
      length(common_at_least_three) / length(all_sig_genes) * 100,
      100
    ), 2)
  )
  print(conservation_summary)
  return(list(
    all_comparisons = common_all_comparisons,
    at_least_four = common_at_least_four,
    at_least_three = common_at_least_three,
    all_genes = all_sig_genes,
    frequency = gene_frequency,
    summary = conservation_summary
  ))
}
