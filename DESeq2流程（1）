  ### 4.4 三组比较结果格式标准化 ###
standardize_three_group_results <- function(lrt_results, dds_object, variance_scores) {
  # 创建与Wald检验结果相同结构的数据框
  three_group_df <- as.data.frame(lrt_results)
  # 添加基因ID列
  three_group_df$gene_id <- rownames(three_group_df)
  # 使用预先计算的变异系数作为log2FoldChange的替代
  three_group_df$log2FoldChange <- log2(variance_scores[three_group_df$gene_id] + 1e-6)
  # 估算lfcSE（基于统计量的相对大小）
  three_group_df$lfcSE <- three_group_df$stat / (max(three_group_df$stat, na.rm = TRUE) / 2)
  # 确保包含所有必需的列
  three_group_df$pvalue <- three_group_df$pvalue
  three_group_df$padj <- three_group_df$padj
  three_group_df$baseMean <- three_group_df$baseMean
  three_group_df$stat <- three_group_df$stat
  # 添加比较类型标识
  three_group_df$comparison_type <- "three_group_LRT"
  # 重新排列列顺序以匹配整理函数的期望
  three_group_df <- three_group_df[, c("gene_id", "log2FoldChange", "lfcSE", "stat", 
                                       "pvalue", "padj", "baseMean", "comparison_type")]
  return(three_group_df)
}
# 应用标准化函数（注意添加variance_scores参数）
results_three_group_standardized <- standardize_three_group_results(
  results_three_group_lrt, dds, gene_variance
)
