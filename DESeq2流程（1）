# DESeq2 差异表达分析完整流程
# 分析三个物种的转录组数据：[Species_A]、[Species_B]、[Species_C]
### 第一部分：环境设置与数据准备 -------------------------------------------------
### 0. 加载统一配置
# 功能：确保所有分析使用相同的参数和设置

### 0.1 加载必要的R包
library(tidyverse)
library(DESeq2)      # 差异表达分析核心包
library(tidyverse)   # 数据整理和可视化
library(pheatmap)    # 热图绘制
library(ggrepel)     # 避免文本重叠
library(EnhancedVolcano) # 火山图绘制
library(reshape2)

### 1. 数据加载与预处理 --------------------------------------------------------
# 读取原始计数矩阵
# 注意：需要根据实际文件路径调整
count_data_brian <- read.table("[counts_matrix].txt",
                               header = TRUE, row.names = 1, skip = 1)
# 提取计数数据部分（跳过前5列的特征信息）
counts_data <- count_data_brian[, 6:ncol(count_data_brian)]
# 数据质量检查
cat("表达矩阵维度:", dim(counts_data), "\n")  # 输出基因数和样本数
cat("样本名称:", colnames(counts_data), "\n") # 检查样本名称
# 读取样本信息表
sample_info <- read.csv("[sample_metadata].csv", row.names = 1)
# 确保样本信息与表达矩阵顺序一致
stopifnot(identical(colnames(counts_data), rownames(sample_info)))
# 将分组变量转换为因子（DESeq2要求）
sample_info$species <- as.factor(sample_info$species)
cat("物种水平:", levels(sample_info$species), "\n")

### 2. 创建DESeq2对象并过滤低表达基因 ------------------------------------------
# 构建DESeqDataSet对象
dds <- DESeqDataSetFromMatrix(
  countData = counts_data,    # 计数矩阵
  colData = sample_info,      # 样本信息
  design = ~ species          # 实验设计公式
)
# 过滤低表达基因（提高分析质量）
# 标准：在至少30%的样本中计数≥10
keep <- rowSums(counts(dds) >= 10) >= 3
dds <- dds[keep, ]
cat("过滤后保留基因数:", nrow(dds), "\n")

### 3. 执行差异表达分析 --------------------------------------------------------
# 运行DESeq2标准分析流程（包括标准化、离散度估计、统计检验）
dds <- DESeq(dds)
# 检查物种因子水平以确定对比组
species_levels <- levels(dds$species)
cat("物种比较顺序:", species_levels, "\n")

### 4. 提取差异表达结果 --------------------------------------------------------
# 定义所有可能的物种两两比较（修正顺序）与三组共同比较
# α = 0.05 表示显著性水平为 5%，用于多重假设检验的校正，控制错误发现率(FDR)，
# padj（校正后p值）的阈值设定，自动对结果进行筛选，只返回 padj < 0.05 的基因，
#(接上一行)用于FDR控制的显著性水平
  ### 4.1 两两比较 ###
  # 功能：执行所有可能的物种两两比较，使用Wald检验
  # 意义：获得具体的物种间差异表达基因，提供详细的倍数变化信息
# 比较1：[Species_B] vs [Species_A]
results_B_vs_A <- results(
  dds,
  contrast = c("species", "[Genus_species_B]", "[Genus_species_A]"),
  alpha = 0.05  # 显著性阈值
)
# 比较2：[Species_B] vs [Species_C]  
results_B_vs_C <- results(
  dds,
  contrast = c("species", "[Genus_species_B]", "[Genus_species_C]"),
  alpha = 0.05
)
# 比较3：[Species_A] vs [Species_B]
results_A_vs_B <- results(
  dds,
  contrast = c("species", "[Genus_species_A]", "[Genus_species_B]"),
  alpha = 0.05
)
# 比较4：[Species_A] vs [Species_C]
results_A_vs_C <- results(
  dds,
  contrast = c("species", "[Genus_species_A]", "[Genus_species_C]"),
  alpha = 0.05
)
# 比较5：[Species_C] vs [Species_B]
results_C_vs_B <- results(
  dds,
  contrast = c("species", "[Genus_species_C]", "[Genus_species_B]"),
  alpha = 0.05
)
# 比较6：[Species_C] vs [Species_A]
results_C_vs_A <- results(
  dds,
  contrast = c("species", "[Genus_species_C]", "[Genus_species_A]"),
  alpha = 0.05
)

### 4.2 三组整体比较 ###
# 功能：使用LRT检验进行三组整体差异分析
# 意义：识别在至少一个物种中表达显著不同的基因，提供全局视角
# 注意：LRT检验更适合多组比较，但结果结构与Wald检验不同
# 重要修正：创建新的DESeq对象避免覆盖原有分析结果
cat("正在创建新的DESeq对象用于LRT检验...\n")
dds_for_lrt <- DESeqDataSetFromMatrix(
  countData = counts(dds),          # 使用已过滤的计数数据
  colData = colData(dds),           # 使用相同的样本信息
  design = ~ species                # 相同的实验设计
)
# 运行LRT检验（似然比检验）
cat("执行LRT检验...\n")
dds_lrt <- DESeq(dds_for_lrt, test = "LRT", reduced = ~1)
results_three_group_lrt <- results(dds_lrt, alpha = 0.05)
# 计算基因在三个物种间的表达变异
# 功能：量化每个基因在物种间的表达变异程度
# 意义：识别高变异基因，可能反映物种特异性表达模式
cat("计算基因表达变异系数...\n")
species_means <- t(apply(counts(dds, normalized=TRUE), 1, 
                         function(x) tapply(x, colData(dds)$species, mean)))
gene_variance <- apply(species_means, 1, function(x) {
  if(mean(x) == 0) return(0)  # 避免除零错误
  sd(x)/mean(x)  # 计算变异系数（标准差/均值）
})
# 移除无限值和NA值以确保数据质量
gene_variance <- gene_variance[is.finite(gene_variance) & !is.na(gene_variance)]
### 分层基因选择策略 ###
# 功能：根据不同分析需求选择不同数量的高变异基因
# 意义：平衡分析深度与计算效率，为不同下游分析提供合适的基因集
# 第一层：热图展示用基因 (前100个高变异基因)
# 应用：用于绘制清晰的热图，避免过度拥挤
top_100_hvg <- names(sort(gene_variance, decreasing = TRUE))[1:100]
cat("热图展示基因: 前100个高变异基因\n")
# 第二层：共表达网络分析用基因 (前5000个高变异基因)
# 应用：WGCNA等共表达网络分析需要足够数量的基因
top_5000_hvg <- names(sort(gene_variance, decreasing = TRUE))[1:5000]
cat("共表达网络分析基因: 前5000个高变异基因\n")
# 第三层：所有显著变异基因 (基于统计阈值)
# 应用：识别统计上显著的高变异基因，用于功能富集分析
variance_threshold <- median(gene_variance) + 2 * mad(gene_variance)  # 中位数绝对偏差
all_significant_hvg <- names(gene_variance[gene_variance > variance_threshold])
cat(sprintf("统计显著高变异基因: %d个 (阈值: %.3f)\n", 
            length(all_significant_hvg), variance_threshold))
# 保存不同层次的基因列表
# 功能：统一保存所有高变异基因列表
# 意义：便于后续分析调用，确保结果可重复性
hvg_lists <- list(
  heatmap_genes = top_100_hvg,
  wgcna_genes = top_5000_hvg,
  all_significant_hvg = all_significant_hvg,
  variance_scores = gene_variance
)
saveRDS(hvg_lists, "[hvg_lists].rds")
cat("✅ 高变异基因列表已保存: [hvg_lists].rds\n")

