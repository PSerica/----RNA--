# 功能：从整理后的结果中提取显著差异基因
# 意义：为GO富集分析、通路分析等下游分析准备基因列表
extract_significant_genes <- function(df, comp_name) {
  # 根据检验类型选择显著基因
  if("lrt" %in% df$test_type) {
    sig_genes <- df[df$DE_status == "LRT_SIGNIFICANT", ]
  } else {
    sig_genes <- df[df$DE_status %in% c("UP", "DOWN"), ]
  }
  # 保存显著基因
  sig_file <- paste0("DESeq2_", gsub(" ", "_", comp_name), "_significant.csv")
  write.csv(sig_genes, sig_file, row.names = FALSE)
  # 分别保存上调和下调基因（仅对Wald检验）
  if(!("lrt" %in% df$test_type)) {
    up_genes <- sig_genes[sig_genes$DE_status == "UP", "gene_id"]
    down_genes <- sig_genes[sig_genes$DE_status == "DOWN", "gene_id"]
    if (length(up_genes) > 0) {
      up_file <- paste0("DESeq2_", gsub(" ", "_", comp_name), "_upregulated.csv")
      write.csv(data.frame(gene_id = up_genes), up_file, row.names = FALSE)
    }
    if (length(down_genes) > 0) {
      down_file <- paste0("DESeq2_", gsub(" ", "_", comp_name), "_downregulated.csv")
      write.csv(data.frame(gene_id = down_genes), down_file, row.names = FALSE)
    }
    return(list(up = up_genes, down = down_genes))
  } else {
    # 对于LRT检验，返回所有显著基因
    lrt_genes <- sig_genes$gene_id
    return(list(lrt_sig = lrt_genes))
  }
}
