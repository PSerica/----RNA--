  ## 5.3 查看各比较组的差异基因统计
cat("\n=== 各比较组差异基因统计 ===\n")
comparison_stats <- function(df, comp_name) {
  up_genes <- sum(df$DE_status == "UP")
  down_genes <- sum(df$DE_status == "DOWN")
  lrt_sig_genes <- sum(df$DE_status == "LRT_SIGNIFICANT")
  total_de <- up_genes + down_genes + lrt_sig_genes
  if("lrt" %in% df$test_type) {
    cat(sprintf("%-40s: LRT显著 %4d基因\n", comp_name, lrt_sig_genes))
  } else {
    cat(sprintf("%-40s: 上调 %4d, 下调 %4d, 总计 %4d\n", 
                comp_name, up_genes, down_genes, total_de))
  }
}
