    },
    C_vs_B = {
      sig <- results_C_vs_B[results_C_vs_B$padj < 0.05 & !is.na(results_C_vs_B$padj), ]
      sig[abs(sig$log2FoldChange) > 2, ]
    },
    C_vs_A = {
      sig <- results_C_vs_A[results_C_vs_A$padj < 0.05 & !is.na(results_C_vs_A$padj), ]
      sig[abs(sig$log2FoldChange) > 2, ]
    },
    # 三组比较：基于变异系数（前10%高变异基因）
    three_group = {
      sig <- results_three_group_lrt[results_three_group_lrt$padj < 0.05 & !is.na(results_three_group_lrt$padj), ]
      high_var_threshold <- quantile(gene_variance, 0.9, na.rm = TRUE)
      high_var_genes <- names(gene_variance)[gene_variance > high_var_threshold]
      sig[rownames(sig) %in% high_var_genes, ]
    }
  )
  ### 策略3: Top数量基因筛选 ###
  # 功能：按显著性排序选取固定数量的顶级基因
  # 意义：为可视化和初步分析提供可管理的基因集合，保证结果可展示性
  cat(">>> 策略3: 筛选Top数量基因...\n")
  top_by_count <- list(
    # 两两比较：前15个最显著基因
    B_vs_A = head(results_B_vs_A[order(results_B_vs_A$padj), ], 15),
    B_vs_C = head(results_B_vs_C[order(results_B_vs_C$padj), ], 15),
    A_vs_B = head(results_A_vs_B[order(results_A_vs_B$padj), ], 15),
    A_vs_C = head(results_A_vs_C[order(results_A_vs_C$padj), ], 15),
    C_vs_B = head(results_C_vs_B[order(results_C_vs_B$padj), ], 15),
    C_vs_A = head(results_C_vs_A[order(results_C_vs_A$padj), ], 15),
    # 三组比较：前20个最显著基因
    three_group = head(results_three_group_lrt[order(results_three_group_lrt$padj), ], 20)
  )
  ### 结果统计与报告 ###
  cat("\n=== 多层次筛选结果统计 ===\n")
  comparisons <- c("[Species_B]_vs_[Species_A]", "[Species_B]_vs_[Species_C]", "[Species_A]_vs_[Species_B]",
                   "[Species_A]_vs_[Species_C]", "[Species_C]_vs_[Species_B]", "[Species_C]_vs_[Species_A]", "Three_Group")
  for(i in 1:7) {
    comp_name <- comparisons[i]
    cat(sprintf("  %-28s: 极显著=%2d, 大效应=%2d, Top数量=%2d\n", 
                comp_name,
                nrow(extreme_sig[[i]]), 
                nrow(large_effect[[i]]),
                nrow(top_by_count[[i]])))
  }
  # 获取标准化计数数据用于可视化
  cat("\n正在准备基因表达数据用于可视化...\n")
  top_gene_counts_list <- lapply(top_by_count, function(genes) {
    if(nrow(genes) > 0) {
      counts(dds, normalized = TRUE)[rownames(genes), ]
    } else {
      NULL
    }
  })
  return(list(
    extreme_significant = extreme_sig,
    large_effect = large_effect,
    top_by_count = top_by_count,
    counts_data = top_gene_counts_list
  ))
}
