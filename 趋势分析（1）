##################################################################
### 趋势分析流程（优化版）
### 功能：基于DESeq2预处理结果，分析基因表达在行为梯度上的变化模式
### 输入：DESeq2分析生成的RDS文件和标准化矩阵
### 输出：趋势基因列表、可视化图表、统计报告
##################################################################
#### 0. 初始化与配置 --------------------------------------------------------
cat("=== 趋势分析：初始化与配置 ===\n")

create_analysis_dirs <- function() {
  dirs <- c("Trend_Visualizations", "Trend_Analysis_Results")
  for(dir in dirs) {
    if(!dir.exists(dir)) dir.create(dir, recursive = TRUE)
  }
}

### 0.2 检查必要文件是否存在
cat("正在检查必要文件...\n")
required_files <- c("DESeq2_Analysis_Object.rds", "Normalized_Counts_Matrix.csv")
missing_files <- required_files[!file.exists(required_files)]
if (length(missing_files) > 0) {
  stop("❌ 缺少必要输入文件: ", paste(missing_files, collapse = ", "))
}
cat("✅ 所有必要文件都存在\n")

### 0.3 记录分析元数据
cat("正在记录分析元数据...\n")
pipeline_metadata <- list(
  analysis_timestamp = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
  brain_region = "[Brain_Region]",
  analysis_stage = "Trend_Analysis",
  r_version = R.version.string,
  deseq2_version = as.character(packageVersion("DESeq2")),
  input_files = required_files
)
saveRDS(pipeline_metadata, "Trend_analysis_metadata.rds")
cat("✅ 分析元数据已保存: Trend_analysis_metadata.rds\n")

### 0.4 加载必要的R包
required_packages <- c("DESeq2", "ggplot2", "pheatmap", "RColorBrewer", "ggpubr", "dplyr")
invisible(lapply(required_packages, function(pkg) {
  if (!require(pkg, character.only = TRUE, quietly = TRUE)) {
    install.packages(pkg)
    library(pkg, character.only = TRUE)
  }
}))
cat("✅ 所有R包加载完成\n")

### 0.4.1 定义物种行为映射
BEHAVIOR_LEVELS <- c(
  "[Species_A]" = "low",      
  "[Species_C]" = "medium",  
  "[Species_B]" = "high"      
)

BEHAVIOR_SCORES <- c(
  "[Species_A]" = 0.0,        
  "[Species_C]" = 0.5, 
  "[Species_B]" = 1.0         
)
cat("✅ 行为映射定义完成\n")

### 0.5 加载输入数据
cat("正在加载输入数据...\n")
dds <- readRDS("DESeq2_Analysis_Object.rds")
normalized_counts <- read.csv("Normalized_Counts_Matrix.csv", row.names = 1)
cat("✅ 输入数据加载完成\n")
cat("   DESeq2对象样本数:", ncol(dds), "\n")
cat("   标准化矩阵维度:", nrow(normalized_counts), "基因 ×", ncol(normalized_counts), "样本\n")

### 0.6 准备趋势分析输入数据
cat("正在准备趋势分析输入数据...\n")
use_all_genes <- FALSE
if (use_all_genes) {
  gene_selection_strategy <- "全部基因集"
  trend_analysis_genes <- rownames(normalized_counts)
  cat("✅ 使用全部基因集进行趋势分析\n")
  cat("   基因数量:", length(trend_analysis_genes), "\n")
} else {
  gene_selection_strategy <- ""
  trend_analysis_genes <- c()
  if (file.exists("[gene_lists].rds")) {
    gene_selection_strategy <- "DESeq2高变异基因"
    deseq2_advanced <- readRDS("[gene_lists].rds")
    if (!is.null(deseq2_advanced$all_significant_hvg) && length(deseq2_advanced$all_significant_hvg) > 0) {
      trend_analysis_genes <- deseq2_advanced$all_significant_hvg
      cat("✅ 使用DESeq2的显著高变异基因列表\n")
    }
  } 
  if (length(trend_analysis_genes) == 0 && file.exists("[hvg_lists].rds")) {
    gene_selection_strategy <- "高变异基因列表"
    hvg_lists <- readRDS("[hvg_lists].rds")
    if (!is.null(hvg_lists$wgcna_genes) && length(hvg_lists$wgcna_genes) > 0) {
      trend_analysis_genes <- hvg_lists$wgcna_genes
      cat("✅ 使用WGCNA基因列表（前5000高变异基因）\n")
    } else if (!is.null(hvg_lists$all_significant_hvg) && length(hvg_lists$all_significant_hvg) > 0) {
      trend_analysis_genes <- hvg_lists$all_significant_hvg
      cat("✅ 使用显著高变异基因列表\n")
    }
  }
  if (length(trend_analysis_genes) == 0 && file.exists("Network_Analysis/High_Variable_Genes_Expression.csv")) {
    gene_selection_strategy <- "网络分析高变异基因"
    hvg_expression <- read.csv("Network_Analysis/High_Variable_Genes_Expression.csv", row.names = 1)
    trend_analysis_genes <- rownames(hvg_expression)
    cat("✅ 使用网络分析的高变异基因\n")
  }
  if (length(trend_analysis_genes) == 0) {
    gene_selection_strategy <- "随机基因子集"
    all_genes <- rownames(normalized_counts)
    set.seed(123)
    if (length(all_genes) > 5000) {
      trend_analysis_genes <- sample(all_genes, 5000)
      cat("✅ 随机选择5000个基因进行趋势分析\n")
    } else {
      trend_analysis_genes <- all_genes
      cat("✅ 使用所有基因进行趋势分析\n")
    }
  }
  trend_analysis_genes <- trend_analysis_genes[trend_analysis_genes %in% rownames(normalized_counts)]
  cat("   最终基因数量:", length(trend_analysis_genes), "（策略:", gene_selection_strategy, "）\n")
  if (length(trend_analysis_genes) == 0) {
    cat("⚠️ 警告：基因列表为空，使用方差最高的500个基因\n")
    gene_variance <- apply(normalized_counts, 1, var)
    top_variance_genes <- names(sort(gene_variance, decreasing = TRUE))[1:500]
    trend_analysis_genes <- top_variance_genes
    gene_selection_strategy <- "高方差基因"
    cat("   备用方案基因数量:", length(trend_analysis_genes), "\n")
  }
}
expr_data <- normalized_counts[trend_analysis_genes, ]
cat("✅ 趋势分析表达矩阵准备完成\n")
cat("   最终矩阵维度:", nrow(expr_data), "个基因,", ncol(expr_data), "个样本\n")
cat("   使用策略:", ifelse(use_all_genes, "全部基因集", paste("分层筛选 (", gene_selection_strategy, ")", sep = "")), "\n")

#### 1. 趋势分析核心方法 ----------------------------------------------------
### 1.1 准备样本信息
sample_info <- as.data.frame(colData(dds))
sample_info$behavior_level <- factor(
  BEHAVIOR_LEVELS[sample_info$species],
  levels = c("low", "medium", "high")
)
sample_info$behavior_score <- BEHAVIOR_SCORES[sample_info$species]
cat("   行为等级分布:\n")
cat("   Low ([Species_A]):", sum(sample_info$behavior_level == "low"), "samples\n")
cat("   Medium ([Species_C]):", sum(sample_info$behavior_level == "medium"), "samples\n")
cat("   High ([Species_B]):", sum(sample_info$behavior_level == "high"), "samples\n")

### 1.2 方法一：有序比较分析
dds_ordered <- DESeqDataSetFromMatrix(
  countData = counts(dds),
  colData = sample_info,
  design = ~ behavior_level
)
dds_ordered <- DESeq(dds_ordered)
results_trend <- results(dds_ordered, 
                         contrast = list("behavior_level_high_vs_low",
                                         "behavior_level_medium_vs_low"))
cat("✅ 有序比较分析完成，检验基因数:", nrow(results_trend), "\n")
cat("   显著趋势基因(padj < 0.05):", sum(results_trend$padj < 0.05, na.rm = TRUE), "\n")

### 1.3 方法二：线性模型趋势分析
dds_continuous <- DESeqDataSetFromMatrix(
  countData = counts(dds),
  colData = sample_info,
  design = ~ behavior_score
)
dds_continuous <- DESeq(dds_continuous)
results_continuous <- results(dds_continuous, name = "behavior_score")
cat("✅ 线性模型分析完成，检验基因数:", nrow(results_continuous), "\n")
cat("   显著相关基因(padj < 0.05):", sum(results_continuous$padj < 0.05, na.rm = TRUE), "\n")

### 1.4 记录分析参数
trend_analysis_parameters <- list(
  gene_selection_strategy = gene_selection_strategy,
  final_gene_count = length(trend_analysis_genes),
  behavior_gradient = BEHAVIOR_SCORES,
  methods_used = c("ordered_comparison", "linear_model", "clustering"),
  significance_threshold = 0.05,
  clustering_parameters = list(kmeans_centers = 6, nstart = 25)
)
saveRDS(trend_analysis_parameters, "Trend_analysis_parameters.rds")
cat("✅ 分析参数已保存: Trend_analysis_parameters.rds\n")

#### 2. 趋势分析方法实施 ----------------------------------------------------
### 2.1 方法三：聚类趋势分析
vsd <- vst(dds_continuous, blind = FALSE)
expr_matrix <- assay(vsd)
hoarding_order <- order(sample_info$behavior_score)
expr_ordered <- expr_matrix[, hoarding_order]
expr_trend_genes <- expr_ordered[trend_analysis_genes, ]
set.seed(123)
kmeans_result <- kmeans(expr_trend_genes, centers = 6, nstart = 25, iter.max = 50)
if(kmeans_result$ifault == 4) {
  warning("K-means可能未完全收敛，考虑使用其他方法")
}
trend_clusters <- data.frame(
  gene_id = rownames(expr_trend_genes),
  cluster = kmeans_result$cluster
)
cat("✅ 聚类分析完成\n")
cat("   聚类数量:", length(unique(kmeans_result$cluster)), "个模式\n")
cat("   各聚类基因分布:", paste(table(kmeans_result$cluster), collapse = ", "), "\n")

#### 3. 结果整合与分析 ------------------------------------------------------
### 3.1 趋势模式分类与一致性分析
ordered_results_df <- as.data.frame(results_trend)
ordered_results_df$gene_id <- rownames(ordered_results_df)
ordered_results_df$trend_type_ordered <- ifelse(
  ordered_results_df$padj < 0.05 & !is.na(ordered_results_df$padj),
  ifelse(ordered_results_df$log2FoldChange > 0, "positive_trend", 
         ifelse(ordered_results_df$log2FoldChange < 0, "negative_trend", "complex_trend")),
  "no_trend"
)
continuous_results_df <- as.data.frame(results_continuous)
continuous_results_df$gene_id <- rownames(continuous_results_df)
continuous_results_df$trend_type_continuous <- ifelse(
  continuous_results_df$padj < 0.05 & !is.na(continuous_results_df$padj),
  ifelse(continuous_results_df$log2FoldChange > 0, "positive_correlation", "negative_correlation"),
  "no_correlation"
)

trend_comparison <- merge(
  ordered_results_df[, c("gene_id", "trend_type_ordered", "log2FoldChange", "padj")],
  continuous_results_df[, c("gene_id", "trend_type_continuous", "log2FoldChange", "padj")],
  by = "gene_id",
  suffixes = c("_ordered", "_continuous")
)

trend_comparison$consistent_pattern <- ifelse(
  trend_comparison$trend_type_ordered %in% c("positive_trend", "negative_trend") &
    trend_comparison$trend_type_continuous %in% c("positive_correlation", "negative_correlation") &
    substr(trend_comparison$trend_type_ordered, 1, 8) == substr(trend_comparison$trend_type_continuous, 1, 8),
  "consistent",
  "inconsistent"
)

### 3.2 聚类模式与统计方法整合
trend_comparison <- merge(trend_comparison, trend_clusters, by = "gene_id", all.x = TRUE)
cluster_trend_summary <- trend_comparison %>%
  group_by(cluster) %>%
  summarise(
    total_genes = n(),
    consistent_positive = sum(consistent_pattern == "consistent" & 
                                trend_type_continuous == "positive_correlation", na.rm = TRUE),
    consistent_negative = sum(consistent_pattern == "consistent" & 
                                trend_type_continuous == "negative_correlation", na.rm = TRUE),
    percent_consistent = round((consistent_positive + consistent_negative) / total_genes * 100, 1)
  ) %>%
  arrange(desc(percent_consistent))
cat("✅ 聚类与统计方法整合完成\n")

### 3.3 与DESeq2结果整合分析
integration_results <- list()
if (file.exists("[gene_lists].rds")) {
  deseq2_advanced <- readRDS("[gene_lists].rds")
  if (!is.null(deseq2_advanced$all_significant_hvg) && length(deseq2_advanced$all_significant_hvg) > 0) {
    consistent_positive <- trend_comparison$gene_id[
      trend_comparison$consistent_pattern == "consistent" & 
        trend_comparison$trend_type_continuous == "positive_correlation"
    ]
    consistent_negative <- trend_comparison$gene_id[
      trend_comparison$consistent_pattern == "consistent" & 
        trend_comparison$trend_type_continuous == "negative_correlation"
    ]
    trend_consistent_genes <- unique(c(consistent_positive, consistent_negative))
    hvg_trend_overlap <- intersect(deseq2_advanced$all_significant_hvg, trend_consistent_genes)
    hvg_overlap_percent <- ifelse(length(trend_consistent_genes) > 0, 
                                  round(length(hvg_trend_overlap) / length(trend_consistent_genes) * 100, 1), 0)
    cat("   DESeq2高变异基因数量:", length(deseq2_advanced$all_significant_hvg), "\n")
    cat("   趋势基因中高变异基因比例:", hvg_overlap_percent, "%\n")
    integration_results <- list(
      consistent_positive_count = length(consistent_positive),
      consistent_negative_count = length(consistent_negative),
      hvg_count = length(deseq2_advanced$all_significant_hvg),
      hvg_overlap_count = length(hvg_trend_overlap),
      hvg_overlap_percent = hvg_overlap_percent
    )
  } else {
    integration_results <- list(
      note = "DESeq2高变异基因列表为空",
      consistent_positive_count = length(consistent_positive),
      consistent_negative_count = length(consistent_negative)
    )
  }
} else {
  consistent_positive <- trend_comparison$gene_id[
    trend_comparison$consistent_pattern == "consistent" & 
      trend_comparison$trend_type_continuous == "positive_correlation"
  ]
  consistent_negative <- trend_comparison$gene_id[
    trend_comparison$consistent_pattern == "consistent" & 
      trend_comparison$trend_type_continuous == "negative_correlation"
  ]
  integration_results <- list(
    note = "使用趋势分析独立结果",
    consistent_positive_count = length(consistent_positive),
    consistent_negative_count = length(consistent_negative),
    total_trend_genes = length(consistent_positive) + length(consistent_negative)
  )
}
if (!dir.exists("Trend_Analysis_Results")) {
  dir.create("Trend_Analysis_Results", recursive = TRUE)
}
saveRDS(integration_results, "Trend_Analysis_Results/deseq2_integration_analysis.rds")
cat("   ✅ 整合分析结果已保存\n")

