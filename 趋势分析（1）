      geom_point(size = 3) +
      geom_smooth(method = "lm", se = TRUE, aes(group = 1), color = "black") +
      labs(title = gene, 
           subtitle = paste("Trend:", trend_comparison$trend_type_continuous[trend_comparison$gene_id == gene]),
           x = "Behavior Score", 
           y = "Normalized Expression") +
      theme_minimal() +
      scale_color_manual(values = SPECIES_COLORS) +
      theme(legend.position = "none")
  }
