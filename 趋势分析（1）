### 4.2 一致趋势基因热图（优化版）
consistent_genes <- trend_comparison$gene_id[trend_comparison$consistent_pattern == "consistent"]
if (length(consistent_genes) > 0) {
  if (length(consistent_genes) > 50) {
    gene_pvals <- continuous_results_df$padj[match(consistent_genes, continuous_results_df$gene_id)]
    valid_indices <- which(!is.na(gene_pvals))
    if (length(valid_indices) >= 50) {
      consistent_genes <- consistent_genes[order(gene_pvals, na.last = TRUE)[1:50]]
    } else {
      consistent_genes <- consistent_genes[valid_indices[1:min(50, length(valid_indices))]]
    }
    cat("   选择前", length(consistent_genes), "个最显著的一致趋势基因进行热图展示\n")
  } else {
    cat("   使用所有", length(consistent_genes), "个一致趋势基因进行热图展示\n")
  }
  available_genes <- consistent_genes[consistent_genes %in% rownames(vsd)]
  if (length(available_genes) == 0) {
    cat("⚠️ 错误：在VST数据中未找到指定的基因\n")
  } else {
    if (length(available_genes) < length(consistent_genes)) {
      cat("⚠️ 警告：", length(consistent_genes) - length(available_genes), 
          "个基因在VST数据中不存在\n")
    }
    vsd_consistent <- vsd[available_genes, ]
    sample_order <- order(sample_info$behavior_score)
    expr_consistent <- assay(vsd_consistent)[, sample_order]
    annotation_df <- data.frame(
      Behavior_Score = sample_info$behavior_score[sample_order],
      Species = factor(sample_info$species[sample_order])
    )
    rownames(annotation_df) <- colnames(expr_consistent)
    if (!exists("SPECIES_COLORS")) {
      cat("⚠️ SPECIES_COLORS未定义，使用默认颜色\n")
      SPECIES_COLORS <- c(
        "[Genus_species_C]" = "#F0A73A",
        "[Genus_species_A]" = "#3ABF99",  
        "[Genus_species_B]" = "#2C91E0"
      )
    }
    if (!dir.exists("Trend_Visualizations")) {
      dir.create("Trend_Visualizations", recursive = TRUE)
    }
    annotation_colors <- list(
      Species = SPECIES_COLORS,
      Behavior_Score = colorRampPalette(c("#F7FBFF", "#08306B"))(50)
    )
    actual_species <- levels(annotation_df$Species)
    species_colors_to_use <- SPECIES_COLORS[actual_species]
    species_colors_to_use <- species_colors_to_use[!sapply(species_colors_to_use, is.null)]
    if (length(species_colors_to_use) > 0) {
      annotation_colors$Species <- species_colors_to_use
    } else {
      cat("⚠️ 警告：物种颜色匹配失败，使用默认颜色\n")
    }
    tryCatch({
      pheatmap(expr_consistent,
               scale = "row",
               cluster_cols = FALSE,
               cluster_rows = TRUE,
               annotation_col = annotation_df,
               annotation_colors = annotation_colors,
               show_rownames = min(20, nrow(expr_consistent)),
               main = paste0("Consistent Trend Genes\n(n=", nrow(expr_consistent), " genes)"),
               color = colorRampPalette(rev(brewer.pal(10, "RdBu")))(100),
               fontsize_row = 8,
               fontsize_col = 8,
               fontsize = 10,
               filename = "Trend_Visualizations/consistent_trends_heatmap.png",
               width = 10, 
               height = max(6, nrow(expr_consistent) * 0.15),
               silent = FALSE)
      cat("✅ 一致趋势基因热图已保存\n")
      pheatmap(expr_consistent,
               scale = "row",
               cluster_cols = FALSE,
               cluster_rows = TRUE,
               annotation_col = annotation_df,
               annotation_colors = annotation_colors,
               show_rownames = min(20, nrow(expr_consistent)),
               main = paste0("Consistent Trend Genes\n(n=", nrow(expr_consistent), " genes)"),
               color = colorRampPalette(rev(brewer.pal(10, "RdBu")))(100),
               fontsize_row = 8,
               fontsize_col = 8,
               fontsize = 10,
               filename = "Trend_Visualizations/consistent_trends_heatmap.pdf",
               width = 10, 
               height = max(6, nrow(expr_consistent) * 0.15))
      cat("✅ 热图PDF版本已保存\n")
    }, error = function(e) {
      cat("❌ 热图绘制失败:", e$message, "\n")
    })
