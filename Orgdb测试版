# 处理KEGG注释
process_kegg_annotations_fast <- function(eggnog_data, id_mapping) {
  cat("开始处理KEGG注释...\n")
  # 提取KEGG_ko列
  kegg_ko <- eggnog_data$KEGG_ko
  # 使用strsplit一次性处理所有KEGG条目
  kegg_split <- strsplit(kegg_ko, ",")
  # 计算每个基因对应的KEGG数量
  kegg_lengths <- sapply(kegg_split, function(x) {
    sum(x != "" & !is.na(x) & x != "-")
  })
  # 创建重复的GID索引
  gid_rep <- rep(id_mapping$GID, kegg_lengths)
  # 一次性解包所有KEGG条目并过滤
  kegg_terms <- unlist(kegg_split)
  valid_terms <- kegg_terms != "" & !is.na(kegg_terms) & kegg_terms != "-"
  # 直接创建数据框
  kegg_annot <- data.frame(
    GID = gid_rep[valid_terms],
    KEGG = kegg_terms[valid_terms],
    stringsAsFactors = FALSE
  )
  cat("完成KEGG注释处理，共", nrow(kegg_annot), "条记录\n")
  return(kegg_annot)
}

