# 清理重复行的函数
clean_duplicates <- function(gene_info, go_annot, kegg_annot) {
  cat("开始清理重复行...\n")
  # 1. 清理gene_info重复
  gene_info_clean <- gene_info[!duplicated(gene_info), ]
  cat("gene_info清理后:", nrow(gene_info_clean), "行 (移除", nrow(gene_info) - nrow(gene_info_clean), "个重复)\n")
  # 2. 清理GO注释重复 (基于GID和GO组合)
  go_annot_clean <- go_annot[!duplicated(go_annot[, c("GID", "GO")]), ]
  cat("GO注释清理后:", nrow(go_annot_clean), "行 (移除", nrow(go_annot) - nrow(go_annot_clean), "个重复)\n")
  # 3. 清理KEGG注释重复 (基于GID和KEGG组合)
  kegg_annot_clean <- kegg_annot[!duplicated(kegg_annot[, c("GID", "KEGG")]), ]
  cat("KEGG注释清理后:", nrow(kegg_annot_clean), "行 (移除", nrow(kegg_annot) - nrow(kegg_annot_clean), "个重复)\n")
  return(list(
    gene_info = gene_info_clean,
    go_annot = go_annot_clean,
    kegg_annot = kegg_annot_clean
  ))
}

