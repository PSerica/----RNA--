# 修复GO注释格式的函数
fix_go_format <- function(go_annot) {
  cat("修复GO注释格式...\n")
  # 只保留符合GO:XXXXXXX格式的条目
  valid_go <- grepl("^GO:\\d+$", go_annot$GO)
  go_annot_fixed <- go_annot[valid_go, ]
  cat("原始GO注释行数:", nrow(go_annot), "\n")
  cat("有效GO格式行数:", nrow(go_annot_fixed), "\n")
  cat("移除无效GO格式行数:", nrow(go_annot) - nrow(go_annot_fixed), "\n")
  # 检查修复后的格式
  cat("修复后GO格式验证:", all(grepl("^GO:\\d+$", go_annot_fixed$GO)), "\n")
  return(go_annot_fixed)
}
