# 修复GID空值的函数
fix_gid_issues <- function(cleaned_data) {
  cat("修复GID空值问题...\n")
  
  # 1. 修复gene_info中的GID
  gene_info_fixed <- cleaned_data$gene_info
  na_gids <- is.na(gene_info_fixed$GID) | gene_info_fixed$GID == ""
  if (sum(na_gids) > 0) {
    cat("修复", sum(na_gids), "个gene_info中的空GID\n")
    gene_info_fixed$GID[na_gids] <- paste0("MISSING_GID_", 1:sum(na_gids))
  }
  # 2. 修复GO注释中的GID
  go_annot_fixed <- cleaned_data$go_annot
  na_gids_go <- is.na(go_annot_fixed$GID) | go_annot_fixed$GID == ""
  if (sum(na_gids_go) > 0) {
    cat("修复", sum(na_gids_go), "个GO注释中的空GID\n")
    # 移除这些行，因为无法关联到有效基因
    go_annot_fixed <- go_annot_fixed[!na_gids_go, ]
  }
  # 3. 修复KEGG注释中的GID
  kegg_annot_fixed <- cleaned_data$kegg_annot
  na_gids_kegg <- is.na(kegg_annot_fixed$GID) | kegg_annot_fixed$GID == ""
  if (sum(na_gids_kegg) > 0) {
    cat("修复", sum(na_gids_kegg), "个KEGG注释中的空GID\n")
    # 移除这些行，因为无法关联到有效基因
    kegg_annot_fixed <- kegg_annot_fixed[!na_gids_kegg, ]
  }
  # 验证修复结果
  cat("修复后验证:\n")
  cat("gene_info空GID:", sum(is.na(gene_info_fixed$GID) | gene_info_fixed$GID == ""), "\n")
  cat("GO注释空GID:", sum(is.na(go_annot_fixed$GID) | go_annot_fixed$GID == ""), "\n")
  cat("KEGG注释空GID:", sum(is.na(kegg_annot_fixed$GID) | kegg_annot_fixed$GID == ""), "\n")
  return(list(
    gene_info = gene_info_fixed,
    go_annot = go_annot_fixed,
    kegg_annot = kegg_annot_fixed
  ))
}

