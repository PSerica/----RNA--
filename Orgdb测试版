# 处理GO注释
process_go_annotations_fast <- function(eggnog_data, id_mapping) {
  cat("开始处理GO注释...\n")
  
  # 使用strsplit和unlist一次性处理所有GO条目
  go_split <- strsplit(eggnog_data$GOs, ",")
  
  # 计算每个基因对应的GO数量
  go_lengths <- sapply(go_split, length)
  
  # 创建重复的GID索引
  gid_rep <- rep(id_mapping$GID, go_lengths)
  
  # 一次性解包所有GO条目
  go_terms <- unlist(go_split)
  # 过滤空值
  non_empty <- go_terms != "" & !is.na(go_terms)
  gid_rep <- gid_rep[non_empty]
  go_terms <- go_terms[non_empty]
  # 直接创建数据框
  go_annot <- data.frame(
    GID = gid_rep,
    GO = go_terms,
    EVIDENCE = "IEA",
    stringsAsFactors = FALSE
  )
  cat("完成GO注释处理，共", nrow(go_annot), "条记录\n")
  return(go_annot)
}

