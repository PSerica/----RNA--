# 修复无效GO注释的函数
fix_invalid_go_annotations <- function(go_annot) {
  cat("修复无效GO注释...\n")
  original_count <- nrow(go_annot)
  # 移除所有无效的GO条目（包括单独的"-"）
  valid_go <- grepl("^GO:\\d+$", go_annot$GO)
  go_annot_fixed <- go_annot[valid_go, ]
  cat("修复结果:\n")
  cat("  原始GO注释数:", original_count, "\n")
  cat("  有效GO注释数:", nrow(go_annot_fixed), "\n")
  cat("  移除无效GO注释:", original_count - nrow(go_annot_fixed), "\n")
  cat("  全部符合GO:XXXXXXX格式:", all(grepl("^GO:\\d+$", go_annot_fixed$GO)), "\n")
  return(go_annot_fixed)
}

