# 定义正确的ID映射创建函数
create_proper_id_mapping <- function(eggnog_data, gtf_gene_ids) {
  cat("创建正确的ID映射...\n")
  #方法：使用eggnog_data的索引创建唯一GID
  id_mapping <- data.frame(
    GID = paste0("GENE_", 1:nrow(eggnog_data)),  # 创建唯一基因ID
    PID = eggnog_data$query,                     # 蛋白质ID
    stringsAsFactors = FALSE
  )
  cat("创建的映射包含", nrow(id_mapping), "条记录\n")
  cat("GID唯一性:", length(unique(id_mapping$GID)) == nrow(id_mapping), "\n")
  cat("PID唯一性:", length(unique(id_mapping$PID)) == nrow(id_mapping), "\n")
  return(id_mapping)
}
