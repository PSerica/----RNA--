### 4.5 KEGG富集分析核心执行器（新流程优化版）
execute_kegg_enrichment_analysis <- function(kegg_preparation_results) {
  cat("第四章第二部分：KEGG富集分析执行 - 开始执行\n")
  cat("=== KEGG富集分析核心执行 ===\n")
  if (is.null(kegg_preparation_results) || 
      kegg_preparation_results$analysis_strategy$primary_analysis != "RECOMMENDED") {
    cat("❌ KEGG分析不可行，跳过执行\n")
    cat("💡 原因:", kegg_preparation_results$analysis_strategy$reason, "\n")
    return(NULL)
  }
  cat("步骤1: 配置KEGG分析参数和环境...\n")
  analysis_params <- kegg_preparation_results$analysis_strategy$analysis_parameters
  best_kegg_column <- kegg_preparation_results$quality_report$best_kegg_column
  high_priority_lists <- kegg_preparation_results$analysis_strategy$high_priority_lists
  cat("   使用KEGG列:", best_kegg_column, "\n")
  cat("   分析参数: p=", analysis_params$pvalue_cutoff, 
      ", q=", analysis_params$qvalue_cutoff, "\n", sep="")
  cat("   高优先级列表:", length(high_priority_lists), "个\n")
  cat("步骤2: 执行高优先级基因列表KEGG分析...\n")
  kegg_results <- list()
  gene_lists <- kegg_preparation_results$gene_lists
  for (list_name in high_priority_lists) {
    cat("   分析基因列表:", list_name, "... ", sep="")
    genes <- gene_lists[[list_name]]
    if (length(genes) >= analysis_params$minGSSize) {
      kegg_result <- perform_single_kegg_analysis(
        genes, list_name, best_kegg_column, analysis_params
      )
      if (!is.null(kegg_result)) {
        kegg_results[[list_name]] <- kegg_result
        cat("成功 (", nrow(kegg_result), " 个通路)\n", sep="")
      } else {
        cat("无显著通路\n")
      }
    } else {
      cat("基因数不足\n")
    }
  }
  cat("步骤3: 执行中等优先级基因列表分析...\n")
  medium_priority_lists <- kegg_preparation_results$analysis_strategy$medium_priority_lists
  if (length(kegg_results) > 0 && length(medium_priority_lists) > 0) {
    for (list_name in medium_priority_lists) {
      cat("   分析基因列表:", list_name, "... ", sep="")
      genes <- gene_lists[[list_name]]
      if (length(genes) >= max(5, analysis_params$minGSSize - 5)) {
        kegg_result <- perform_single_kegg_analysis(
          genes, list_name, best_kegg_column, analysis_params
        )
        if (!is.null(kegg_result)) {
          kegg_results[[list_name]] <- kegg_result
          cat("成功 (", nrow(kegg_result), " 个通路)\n", sep="")
        } else {
          cat("无显著通路\n")
        }
      } else {
        cat("基因数不足\n")
      }
    }
  }
  cat("步骤4: KEGG分析结果统计和质量评估...\n")
  total_analyses <- length(kegg_results)
  total_pathways <- sum(sapply(kegg_results, nrow))
  success_rate <- round(total_analyses / length(high_priority_lists) * 100, 1)
  cat("   分析完成统计:\n")
  cat("     - 成功分析数:", total_analyses, "/", length(high_priority_lists), "\n")
  cat("     - 总显著通路数:", total_pathways, "\n")
  cat("     - 成功率:", success_rate, "%\n")
  cat("步骤5: 保存初步分析结果...\n")
  if (length(kegg_results) > 0) {
    preliminary_results <- list(
      kegg_results = kegg_results,
      analysis_params = analysis_params,
      best_kegg_column = best_kegg_column,
      gene_lists_analyzed = names(kegg_results),
      analysis_timestamp = Sys.time()
    )
    saveRDS(preliminary_results, "KEGG_Preliminary_Analysis_Results.rds")
    cat("   ✅ 初步分析结果已保存\n")
  }
  cat("✅ KEGG富集分析执行完成\n")
  return(kegg_results)
}

### 4.6 单个KEGG分析执行函数（优化版）
perform_single_kegg_analysis <- function(genes, list_name, kegg_column, analysis_params) {
  tryCatch({
    gene_kegg <- AnnotationDbi::select(
      org.[YourSpecies].eg.db,
      keys = genes,
      columns = kegg_column,
      keytype = "GID"
    )
    kegg_ids <- gene_kegg[[kegg_column]]
    kegg_ids_clean <- clean_kegg_ids(kegg_ids)
    if (length(kegg_ids_clean) < analysis_params$minGSSize) {
      return(NULL)
    }
    organism_info <- determine_kegg_organism(kegg_ids_clean)
    kk <- enrichKEGG(
      gene = kegg_ids_clean,
      organism = organism_info$organism,
      keyType = organism_info$keyType,
      pvalueCutoff = analysis_params$pvalue_cutoff,
      pAdjustMethod = "BH",
      qvalueCutoff = analysis_params$qvalue_cutoff,
      minGSSize = analysis_params$minGSSize,
      maxGSSize = analysis_params$maxGSSize
    )
    if (!is.null(kk) && nrow(kk) > 0) {
      result_df <- as.data.frame(kk)
      result_df$GeneList_Name <- list_name
      result_df$Input_Gene_Count <- length(genes)
      result_df$KEGG_ID_Count <- length(kegg_ids_clean)
      result_df$KEGG_Column_Used <- kegg_column
      result_df$Organism_Used <- organism_info$organism
      result_df$Analysis_Timestamp <- format(Sys.time(), "%Y-%m-%d %H:%M:%S")
      result_df$Biological_Context <- get_biological_context(list_name)
      return(result_df)
    }
    return(NULL)
  }, error = function(e) {
    cat("KEGG分析错误:", e$message, "\n")
    return(NULL)
  })
}

### 4.7 KEGG ID清理和格式统一函数
clean_kegg_ids <- function(kegg_ids) {
  kegg_ids <- kegg_ids[!is.na(kegg_ids) & kegg_ids != ""]
  if (length(kegg_ids) == 0) {
    return(character(0))
  }
  kegg_ids <- gsub("^ko:", "", kegg_ids)
  kegg_ids <- gsub("^KEGG:", "", kegg_ids)
  kegg_ids <- gsub("^path:", "", kegg_ids)
  kegg_ids <- gsub("\\s+", "", kegg_ids)
  kegg_ids <- gsub("\\[.*\\]", "", kegg_ids)
  valid_pattern <- "^(K[0-9]+)$"
  valid_ids <- kegg_ids[grepl(valid_pattern, kegg_ids)]
  return(unique(valid_ids))
}

