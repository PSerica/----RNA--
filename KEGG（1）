setup_kegg_analysis_environment <- function() {
  cat("=== KEGG通路分析环境设置 ===\n")
  kegg_packages <- c(
    "clusterProfiler",
    "org.[YourSpecies].eg.db",
    "enrichplot",
    "pathview",
    "KEGGREST",
    "httr",
    "jsonlite"
  )
  cat("步骤1: 检查KEGG分析专用包...\n")
  for (pkg in kegg_packages) {
    if (!require(pkg, character.only = TRUE, quietly = TRUE)) {
      if (pkg %in% c("clusterProfiler", "org.[YourSpecies].eg.db", "enrichplot")) {
        BiocManager::install(pkg)
      } else {
        install.packages(pkg)
      }
      library(pkg, character.only = TRUE)
      cat("   加载: ", pkg, " ", packageVersion(pkg), "\n", sep = "")
    }
  }
  cat("步骤2: 配置KEGG分析环境...\n")
  options(timeout = 300)
  set.seed(123)
  cat("✅ KEGG分析环境设置完成\n")
  return(TRUE)
}

