### 5.5 新流程共同基因分析报告生成器
generate_new_pipeline_common_genes_report <- function(common_analysis, species_specific_analysis, saved_files) {
  cat("\n=== 生成新流程共同基因分析综合报告 ===\n")
  report_df <- data.frame(
    Analysis_Category = character(),
    Gene_Set_Type = character(),
    Gene_Count = integer(),
    Confidence_Level = character(),
    Biological_Significance = character(),
    Recommended_Action = character(),
    stringsAsFactors = FALSE
  )
  report_categories <- list(
    list("最高置信度", "High_Confidence_Genes", common_analysis$high_confidence_genes, 
         "最高", "跨方法保守的核心差异基因", "优先功能验证"),
    list("保守上调", "Conservative_Upregulated", common_analysis$conservative_up_genes,
         "高", "可能促进目标性状的关键基因", "深入功能研究"),
    list("保守下调", "Conservative_Downregulated", common_analysis$conservative_down_genes, 
         "高", "可能抑制目标性状的关键基因", "深入功能研究"),
    list("趋势-WGCNA重叠", "Trend_WGCNA_Overlap", common_analysis$trend_wgcna_overlap$all_trend_wgcna,
         "中高", "行为相关且网络重要的综合基因", "网络和功能整合分析")
  )
  for (category in report_categories) {
    if (length(category[[3]]) > 0) {
      report_df <- rbind(report_df, data.frame(
        Analysis_Category = category[[1]],
        Gene_Set_Type = category[[2]],
        Gene_Count = length(category[[3]]),
        Confidence_Level = category[[4]],
        Biological_Significance = category[[5]],
        Recommended_Action = category[[6]],
        stringsAsFactors = FALSE
      ))
    }
  }
  write.csv(report_df, "New_Pipeline_Common_Genes_Comprehensive_Report.csv", row.names = FALSE)
  cat("✅ 共同基因分析综合报告已保存\n")
  cat("\n=== 共同基因分析报告摘要 ===\n")
  cat("总分析类别: ", nrow(report_df), "\n", sep="")
  cat("总报告基因数: ", sum(report_df$Gene_Count), "\n", sep="")
  cat("最高置信度发现: ", sum(report_df$Gene_Count[report_df$Confidence_Level == "最高"]), " 个基因\n", sep="")
  cat("\n🎯 重点推荐:\n")
  high_confidence_sets <- report_df[report_df$Confidence_Level %in% c("最高", "高"), ]
  for (i in 1:nrow(high_confidence_sets)) {
    cat("  • ", high_confidence_sets$Gene_Set_Type[i], ": ", 
        high_confidence_sets$Gene_Count[i],
