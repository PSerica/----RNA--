### 4.2 深度KEGG注释质量评估（新流程适配版）
evaluate_kegg_annotation_quality <- function(gene_lists) {
  cat("\n=== 深度KEGG注释质量评估 ===\n")
  cat("步骤1: 收集新流程所有分析基因...\n")
  all_analysis_genes <- unique(unlist(gene_lists))
  cat("   新流程总基因数量: ", length(all_analysis_genes), "\n", sep = "")
  cat("   各分析方法基因贡献:\n")
  for (list_name in names(gene_lists)) {
    gene_count <- length(gene_lists[[list_name]])
    cat("     - ", list_name, ": ", gene_count, " 个基因\n", sep = "")
  }
  cat("步骤2: 探索OrgDb包结构...\n")
  available_columns <- columns(org.[YourSpecies].eg.db)
  cat("   OrgDb包总列数: ", length(available_columns), "\n", sep = "")
  kegg_keywords <- c("KEGG", "PATH", "KO", "PATHWAY")
  kegg_related_columns <- character()
  for (keyword in kegg_keywords) {
    matches <- available_columns[grep(keyword, available_columns, ignore.case = TRUE)]
    kegg_related_columns <- unique(c(kegg_related_columns, matches))
  }
  cat("   发现的KEGG相关列: ", length(kegg_related_columns), "\n", sep = "")
  if (length(kegg_related_columns) > 0) {
    cat("    具体列名: ", paste(kegg_related_columns, collapse = ", "), "\n")
  }
  cat("步骤3: 系统测试KEGG相关列...\n")
  column_evaluation_results <- list()
  for (kegg_column in kegg_related_columns) {
    cat("   测试列: ", kegg_column, "... ", sep = "")
    tryCatch({
      test_genes <- sample(all_analysis_genes, min(20, length(all_analysis_genes)))
      test_annotation <- AnnotationDbi::select(
        org.[YourSpecies].eg.db,
        keys = test_genes,
        columns = kegg_column,
        keytype = "GID"
      )
      total_tests <- length(test_genes)
      valid_entries <- sum(!is.na(test_annotation[[kegg_column]]))
      unique_annotations <- length(unique(na.omit(test_annotation[[kegg_column]])))
      coverage_rate <- valid_entries / total_tests * 100
      column_evaluation_results[[kegg_column]] <- list(
        success = TRUE,
        coverage_rate = coverage_rate,
        valid_entries = valid_entries,
        unique_annotations = unique_annotations,
        sample_annotations = head(na.omit(test_annotation[[kegg_column]]), 3),
        test_size = total_tests
      )
      cat("成功 | 覆盖度: ", round(coverage_rate, 1), "% | ", 
          "有效条目: ", valid_entries, "/", total_tests, " | ",
          "唯一注释: ", unique_annotations, "\n", sep = "")
    }, error = function(e) {
      column_evaluation_results[[kegg_column]] <- list(
        success = FALSE,
        error_message = e$message
      )
      cat("失败 | 错误: ", e$message, "\n", sep = "")
    })
  }
  cat("步骤4: 选择最佳KEGG注释列...\n")
  successful_columns <- names(column_evaluation_results)[
    sapply(column_evaluation_results, function(x) x$success)
  ]
  if (length(successful_columns) == 0) {
    cat("   ❌ 严重问题: 所有KEGG相关列测试失败！\n")
    return(list(
      analysis_possible = FALSE,
      error_message = "没有可用的KEGG注释列",
      evaluation_details = column_evaluation_results
    ))
  }
  coverage_rates <- sapply(column_evaluation_results[successful_columns], 
                           function(x) x$coverage_rate)
  best_column <- successful_columns[which.max(coverage_rates)]
  best_coverage <- max(coverage_rates)
  cat("   ✅ 选择最佳列: ", best_column, "\n", sep = "")
  cat("   最佳列覆盖度: ", round(best_coverage, 1), "%\n", sep = "")
  cat("步骤5: 完整注释覆盖度评估...\n")
  full_annotation <- AnnotationDbi::select(
    org.[YourSpecies].eg.db,
    keys = all_analysis_genes,
    columns = best_column,
    keytype = "GID"
  )
  genes_with_kegg <- unique(full_annotation$GID[!is.na(full_annotation[[best_column]])])
  overall_coverage <- length(genes_with_kegg) / length(all_analysis_genes) * 100
  cat("   总体KEGG注释覆盖度: ", round(overall_coverage, 1), "%\n", sep = "")
  cat("   有KEGG注释基因数: ", length(genes_with_kegg), "/", 
      length(all_analysis_genes), "\n", sep = "")
  cat("   各分析方法KEGG覆盖度:\n")
  method_coverage <- list()
  for (list_name in names(gene_lists)) {
    method_genes <- gene_lists[[list_name]]
    method_with_kegg <- sum(method_genes %in% genes_with_kegg)
    method_coverage_rate <- method_with_kegg / length(method_genes) * 100
    method_coverage[[list_name]] <- method_coverage_rate
    cat("     - ", list_name, ": ", round(method_coverage_rate, 1), 
        "% (", method_with_kegg, "/", length(method_genes), ")\n", sep = "")
  }
  cat("步骤6: 生成详细的质量评估报告...\n")
  quality_report <- list(
    analysis_possible = overall_coverage >= 10,
    best_kegg_column = best_column,
    overall_coverage_rate = overall_coverage,
    genes_with_kegg = genes_with_kegg,
    total_analysis_genes = length(all_analysis_genes),
    method_coverage_rates = method_coverage,
    column_evaluation_details = column_evaluation_results,
    full_annotation_data = full_annotation,
    quality_assessment = ifelse(overall_coverage >= 30, "优秀",
                                ifelse(overall_coverage >= 15, "良好",
                                       ifelse(overall_coverage >= 10, "一般", "较差")))
  )
  cat("步骤6: KEGG注释质量评估结论...\n")
  if (quality_report$analysis_possible) {
    cat("   ✅ KEGG分析可行性: 通过\n")
    cat("   质量等级: ", quality_report$quality_assessment, "\n", sep = "")
    cat("   推荐进行KEGG通路富集分析\n")
  } else {
    cat("   ❌ KEGG分析可行性: 不通过\n")
    cat("   警告: KEGG注释覆盖度过低，分析结果可能不可靠\n")
    cat("   建议: 专注于GO分析结果，或考虑其他通路分析方法\n")
  }
  cat("✅ KEGG注释质量评估完成\n")
  return(quality_report)
}

### 4.3 KEGG分析策略制定器（新流程优化版）
formulate_kegg_analysis_strategy <- function(quality_report, gene_lists) {
  cat("\n=== KEGG分析策略制定 ===\n")
  analysis_strategy <- list()
  if (!quality_report$analysis_possible) {
    cat("步骤1: 分析可行性评估...\n")
    cat("   ❌ KEGG分析不可行: 注释覆盖度过低\n")
    cat("   制定备选方案...\n")
    analysis_strategy$primary_analysis <- "NOT_RECOMMENDED"
    analysis_strategy$reason <- paste("KEGG注释覆盖度过低:",
                                      round(quality_report$overall_coverage_rate, 1), "%")
    analysis_strategy$alternative_approaches <- c(
      "专注于GO富集分析结果",
      "考虑使用其他通路数据库（如Reactome）",
      "使用基因集富集分析（GSEA）方法",
      "基于蛋白质互作网络进行模块分析"
    )
    return(analysis_strategy)
  }
  cat("步骤1: 制定基因列表优先级策略...\n")
  priority_scores <- list()
  for (list_name in names(gene_lists)) {
    genes <- gene_lists[[list_name]]
    coverage_rate <- quality_report$method_coverage_rates[[list_name]]
    gene_count <- length(genes)
    coverage_score <- coverage_rate / 100 * 0.6
    count_score <- pmin(gene_count / 100, 1) * 0.4
    priority_score <- coverage_score + count_score
    priority_scores[[list_name]] <- list(
      coverage_rate = coverage_rate,
      gene_count = gene_count,
      priority_score = priority_score,
      recommended = coverage_rate >= 20 && gene_count >= 15
    )
  }
  cat("步骤2: 基因列表分类和分析计划制定...\n")
  high_priority_lists <- names(priority_scores)[
    sapply(priority_scores, function(x) x$recommended)
  ]
  medium_priority_lists <- names(priority_scores)[
    sapply(priority_scores, function(x) 
      !x$recommended && x$coverage_rate >= 10 && x$gene_count >= 10)
  ]
  low_priority_lists <- names(priority_scores)[
    sapply(priority_scores, function(x) 
      x$coverage_rate < 10 || x$gene_count < 10)
  ]
  cat("   高优先级列表 (推荐分析): ", length(high_priority_lists), "\n", sep = "")
  for (list_name in high_priority_lists) {
    score_info <- priority_scores[[list_name]]
    cat("     - ", list_name, ": ", round(score_info$coverage_rate, 1),
        "% 覆盖度, ", score_info$gene_count, " 基因\n", sep = "")
  }
  cat("   中优先级列表 (条件分析): ", length(medium_priority_lists), "\n", sep = "")
  cat("   低优先级列表 (不推荐): ", length(low_priority_lists), "\n", sep = "")
  cat("步骤3: 制定分析参数策略...\n")
  overall_coverage <- quality_report$overall_coverage_rate
  if (overall_coverage >= 30) {
    analysis_params <- list(
      pvalue_cutoff = 0.05,
      qvalue_cutoff = 0.2,
      minGSSize = 10,
      maxGSSize = 500,
      organism = "ko",
      keyType = "kegg"
    )
    cat("   参数策略: 标准参数 (高质量注释)\n")
  } else if (overall_coverage >= 15) {
    analysis_params <- list(
      pvalue_cutoff = 0.1,
      qvalue_cutoff = 0.3,
      minGSSize = 5,
      maxGSSize = 800,
      organism = "ko",
      keyType = "kegg"
    )
    cat("   参数策略: 宽松参数 (中等质量注释)\n")
  } else {
    analysis_params <- list(
      pvalue_cutoff = 0.15,
      qvalue_cutoff = 0.4,
      minGSSize = 3,
      maxGSSize = 1000,
      organism = "ko", 
      keyType = "kegg"
    )
    cat("   参数策略: 极宽松参数 (低质量注释)\n")
  }
  cat("步骤4: 制定备选分析方案...\n")
  alternative_strategies <- list(
    primary = "标准KEGG富集分析",
    secondary = c(
      "KEGG模块富集分析",
      "通路拓扑分析",
      "基于GO结果的通路推断"
    ),
    fallback = "专注于GO分析和蛋白质互作网络分析"
  )
  analysis_strategy <- list(
    primary_analysis = "RECOMMENDED",
    overall_quality = quality_report$quality_assessment,
    best_kegg_column = quality_report$best_kegg_column,
    high_priority_lists = high_priority_lists,
    medium_priority_lists = medium_priority_lists,
    low_priority_lists = low_priority_lists,
    priority_scores = priority_scores,
    analysis_parameters = analysis_params,
    alternative_strategies = alternative_strategies,
    expected_success_rate = round(mean(sapply(priority_scores[high_priority_lists], 
                                              function(x) x$coverage_rate)), 1)
  )
  cat("步骤5: 策略制定完成...\n")
  cat("   预期成功率: ", analysis_strategy$expected_success_rate, "%\n", sep = "")
  cat("   重点分析列表: ", length(high_priority_lists), " 个\n", sep = "")
  cat("   分析参数: ", analysis_params$pvalue_cutoff, " p值阈值\n", sep = "")
  cat("✅ KEGG分析策略制定完成\n")
  return(analysis_strategy)
}

