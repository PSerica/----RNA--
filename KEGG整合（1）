### 4.7 KEGG ID清理和格式统一函数
clean_kegg_ids <- function(kegg_ids) {
  kegg_ids <- kegg_ids[!is.na(kegg_ids) & kegg_ids != ""]
  if (length(kegg_ids) == 0) {
    return(character(0))
  }
  kegg_ids <- gsub("^ko:", "", kegg_ids)
  kegg_ids <- gsub("^KEGG:", "", kegg_ids)
  kegg_ids <- gsub("^path:", "", kegg_ids)
  kegg_ids <- gsub("\\s+", "", kegg_ids)
  kegg_ids <- gsub("\\[.*\\]", "", kegg_ids)
  valid_pattern <- "^(K[0-9]+)$"
  valid_ids <- kegg_ids[grepl(valid_pattern, kegg_ids)]
  return(unique(valid_ids))
}

