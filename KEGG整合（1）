### 4.11 KEGG结果整合与标准化处理（无可视化版）
integrate_and_process_kegg_results <- function(kegg_enrichment_results) {
  cat("第四章第三部分：KEGG结果处理与统计分析 - 开始执行\n")
  cat("=== KEGG结果整合与标准化处理 ===\n")
  if (is.null(kegg_enrichment_results) || is.null(kegg_enrichment_results$enrichment_results)) {
    cat("❌ 错误: 未找到KEGG分析结果\n")
    return(NULL)
  }
  kegg_results <- kegg_enrichment_results$enrichment_results
  prep_results <- kegg_enrichment_results$preparation_results
  cat("步骤1: 创建整合结果数据框架...\n")
  integrated_df <- data.frame()
  for (list_name in names(kegg_results)) {
    result_df <- kegg_results[[list_name]]
    if (nrow(result_df) > 0) {
      result_df$Analysis_ID <- list_name
      result_df$Confidence_Level <- ifelse(
        list_name %in% prep_results$analysis_strategy$high_priority_lists,
        "High", "Medium"
      )
      result_df$GeneRatio_Numeric <- sapply(strsplit(result_df$GeneRatio, "/"), 
                                            function(x) as.numeric(x[1])/as.numeric(x[2]))
      result_df$BgRatio_Numeric <- sapply(strsplit(result_df$BgRatio, "/"), 
                                          function(x) as.numeric(x[1])/as.numeric(x[2]))
      result_df$Enrichment_Score <- -log10(result_df$pvalue)
      result_df$Fold_Enrichment <- result_df$GeneRatio_Numeric / result_df$BgRatio_Numeric
      integrated_df <- rbind(integrated_df, result_df)
    }
  }
  cat("   整合结果包含:", nrow(integrated_df), "个通路条目\n")
  cat("   涉及分析数量:", length(unique(integrated_df$Analysis_ID)), "\n")
  cat("步骤2: 通路显著性分析和排名...\n")
  pathway_stats <- data.frame(
    ID = character(),
    Description = character(),
    Total_Occurrences = integer(),
    Mean_pvalue = numeric(),
    Min_pvalue = numeric(),
    Max_Enrichment = numeric(),
    Analysis_Count = integer(),
    stringsAsFactors = FALSE
  )
  unique_pathways <- unique(integrated_df$ID)
  for (pathway_id in unique_pathways) {
    pathway_data <- integrated_df[integrated_df$ID == pathway_id, ]
    pathway_desc <- unique(pathway_data$Description)[1]
    pathway_stats <- rbind(pathway_stats, data.frame(
      ID = pathway_id,
      Description = pathway_desc,
      Total_Occurrences = nrow(pathway_data),
      Mean_pvalue = mean(pathway_data$pvalue, na.rm = TRUE),
      Min_pvalue = min(pathway_data$pvalue, na.rm = TRUE),
      Max_Enrichment = max(pathway_data$Enrichment_Score, na.rm = TRUE),
      Analysis_Count = length(unique(pathway_data$Analysis_ID)),
      stringsAsFactors = FALSE
    ))
  }
  pathway_stats <- pathway_stats[order(pathway_stats$Min_pvalue), ]
  high_frequency_pathways <- pathway_stats[pathway_stats$Total_Occurrences >= 2, ]
  high_frequency_pathways <- high_frequency_pathways[order(-high_frequency_pathways$Total_Occurrences, high_frequency_pathways$Min_pvalue), ]
  cat("   高频通路(≥2次出现):", nrow(high_frequency_pathways), "个\n")
  cat("步骤3: 通路功能分类和注释...\n")
  pathway_categories <- list(
    "Neurobiology" = c("Neuroactive", "Dopaminergic", "GABAergic", "Glutamatergic", 
                       "Cholinergic", "Serotonergic", "Synaptic", "Axon", "Dendrite"),
    "Behavior_Cognition" = c("Learning", "Memory", "Cognition", "Behavior", "Reward"),
    "Metabolism" = c("Metabolic", "Glycolysis", "Oxidative", "Phosphorylation", "Biosynthesis"),
    "Signaling" = c("Signaling", "Pathway", "Receptor", "Transduction", "Cascade"),
    "Cellular_Process" = c("Endocytosis", "Autophagy", "Apoptosis", "Cell cycle", "Transport")
  )
  integrated_df$Functional_Category <- "Other"
  for (category in names(pathway_categories)) {
    keywords <- pathway_categories[[category]]
    for (keyword in keywords) {
      matches <- grepl(keyword, integrated_df$Description, ignore.case = TRUE)
      integrated_df$Functional_Category[matches] <- category
    }
  }
  cat("步骤4: 结果质量评估...\n")
  quality_metrics <- list(
    total_pathways = nrow(integrated_df),
    unique_pathways = length(unique(integrated_df$ID)),
    analyses_with_results = length(unique(integrated_df$Analysis_ID)),
    high_confidence_pathways = sum(integrated_df$Confidence_Level == "High"),
    high_frequency_pathways = nrow(high_frequency_pathways),
    avg_pathways_per_analysis = round(nrow(integrated_df) / length(unique(integrated_df$Analysis_ID)), 1)
  )
  cat("   质量指标:\n")
  cat("     - 总通路条目:", quality_metrics$total_pathways, "\n")
  cat("     - 唯一通路数:", quality_metrics$unique_pathways, "\n")
  cat("     - 高置信度条目:", quality_metrics$high_confidence_pathways, "\n")
  cat("     - 高频通路:", quality_metrics$high_frequency_pathways, "\n")
  cat("步骤5: 生成标准化输出文件...\n")
  write.csv(integrated_df, "KEGG_Integrated_Results_Detailed.csv", row.names = FALSE)
  write.csv(pathway_stats, "KEGG_Pathway_Statistics.csv", row.names = FALSE)
  write.csv(high_frequency_pathways, "KEGG_High_Frequency_Pathways.csv", row.names = FALSE)
  for (list_name in names(kegg_results)) {
    if (nrow(kegg_results[[list_name]]) > 0) {
      filename <- paste0("KEGG_Results_", list_name, ".csv")
      write.csv(kegg_results[[list_name]], filename, row.names = FALSE)
    }
  }
  processed_results <- list(
    integrated_results = integrated_df,
    pathway_statistics = pathway_stats,
    high_frequency_pathways = high_frequency_pathways,
    quality_metrics = quality_metrics,
    functional_categories = table(integrated_df$Functional_Category)
  )
  cat("✅ KEGG结果处理完成\n")
  cat("   生成文件: KEGG_Integrated_Results_Detailed.csv\n")
  cat("            KEGG_Pathway_Statistics.csv\n")
  cat("            KEGG_High_Frequency_Pathways.csv\n")
  cat("            KEGG_Results_*.csv\n")
  return(processed_results)
}

### 4.12 KEGG结果质量评估函数
evaluate_kegg_results_quality <- function(processed_results, prep_results) {
  cat("\n=== KEGG结果质量评估 ===\n")
  quality_report <- list()
  integrated_df <- processed_results$integrated_results
  quality_metrics <- processed_results$quality_metrics
  coverage_quality <- ifelse(quality_metrics$analyses_with_results >= 3, "优秀",
                             ifelse(quality_metrics$analyses_with_results >= 2, "良好", "一般"))
  diversity_quality <- ifelse(quality_metrics$unique_pathways >= 10, "优秀",
                              ifelse(quality_metrics$unique_pathways >= 5, "良好", "一般"))
  mean_enrichment <- mean(integrated_df$Fold_Enrichment, na.rm = TRUE)
  enrichment_quality <- ifelse(mean_enrichment >= 3, "优秀",
                               ifelse(mean_enrichment >= 2, "良好", "一般"))
  mean_pvalue <- mean(integrated_df$pvalue, na.rm = TRUE)
  significance_quality <- ifelse(mean_pvalue <= 0.01, "优秀",
                                 ifelse(mean_pvalue <= 0.05, "良好", "一般"))
  quality_scores <- c(
    coverage_quality == "优秀",
    diversity_quality == "优秀", 
    enrichment_quality == "优秀",
    significance_quality == "优秀"
  )
  excellent_count <- sum(quality_scores)
  overall_quality <- ifelse(excellent_count >= 3, "优秀",
                            ifelse(excellent_count >= 2, "良好", "一般"))
  quality_report <- list(
    overall_quality = overall_quality,
    coverage = list(quality = coverage_quality, value = quality_metrics$analyses_with_results),
    diversity = list(quality = diversity_quality, value = quality_metrics$unique_pathways),
    enrichment = list(quality = enrichment_quality, value = round(mean_enrichment, 2)),
    significance = list(quality = significance_quality, value = round(mean_pvalue, 4)),
    metrics = quality_metrics,
    interpretation = ifelse(overall_quality == "优秀", "结果质量优秀，适合深入生物学解释",
                            ifelse(overall_quality == "良好", "结果质量良好，可进行生物学解释",
                                   "结果质量一般，解释需谨慎"))
  )
  cat("   质量评估结果:\n")
  cat("     - 总体质量:", quality_report$overall_quality, "\n")
  cat("     - 分析覆盖度:", quality_report$coverage$quality, 
      "(", quality_report$coverage$value, "个分析)\n", sep="")
  cat("     - 通路多样性:", quality_report$diversity$quality,
      "(", quality_report$diversity$value, "个通路)\n", sep="")
  cat("     - 富集强度:", quality_report$enrichment$quality,
      "(平均", quality_report$enrichment$value, "倍)\n", sep="")
