### 4.14 KEGG与GO结果整合分析（新流程优化版）
integrate_kegg_go_results <- function(kegg_processing_results, go_analysis_results) {
  cat("第四章第四部分：KEGG通路整合分析 - 开始执行\n")
  cat("=== KEGG与GO结果整合分析 ===\n")
  if (is.null(kegg_processing_results) || is.null(go_analysis_results)) {
    cat("❌ 错误: 缺少KEGG或GO分析结果\n")
    return(NULL)
  }
  kegg_integrated <- kegg_processing_results$processed_results$integrated_results
  go_results <- go_analysis_results$go_results
  cat("步骤1: 构建基因列表到功能的映射...\n")
  functional_network <- list()
  for (i in 1:nrow(kegg_integrated)) {
    analysis_id <- kegg_integrated$Analysis_ID[i]
    pathway_id <- kegg_integrated$ID[i]
    pathway_desc <- kegg_integrated$Description[i]
    pvalue <- kegg_integrated$pvalue[i]
    if (!analysis_id %in% names(functional_network)) {
      functional_network[[analysis_id]] <- list()
    }
    functional_network[[analysis_id]]$KEGG <- c(
      functional_network[[analysis_id]]$KEGG,
      paste0(pathway_desc, " (p=", format(pvalue, scientific = TRUE, digits = 2), ")")
    )
  }
  for (result_id in names(go_results)) {
    if (grepl("_BP$", result_id)) {
      go_df <- as.data.frame(go_results[[result_id]])
      if (nrow(go_df) > 0) {
        analysis_id <- gsub("_BP$", "", result_id)
        if (!analysis_id %in% names(functional_network)) {
          functional_network[[analysis_id]] <- list()
        }
        top_go <- head(go_df[order(go_df$pvalue), ], 5)
        functional_network[[analysis_id]]$GO <- top_go$Description
      }
    }
  }
  cat("   构建功能网络覆盖:", length(functional_network), "个分析单元\n")
  cat("步骤2: 跨方法一致性分析...\n")
  consistency_analysis <- analyze_cross_method_consistency(functional_network)
  cat("步骤3: 识别高置信度功能模块...\n")
  high_confidence_modules <- identify_high_confidence_modules(
    kegg_integrated, go_results, consistency_analysis)
  cat("步骤4: 生成整合分析报告...\n")
  integration_report <- generate_integration_report(
    functional_network, consistency_analysis, high_confidence_modules)
  integration_results <- list(
    functional_network = functional_network,
    consistency_analysis = consistency_analysis,
    high_confidence_modules = high_confidence_modules,
    integration_report = integration_report,
    kegg_go_overlap = calculate_kegg_go_overlap(kegg_integrated, go_results)
  )
  cat("✅ KEGG-GO整合分析完成\n")
  return(integration_results)
}

### 4.15 跨方法一致性分析函数
analyze_cross_method_consistency <- function(functional_network) {
  consistency_results <- list()
  consistency_scores <- numeric()
  overlapping_analyses <- character()
  for (analysis_id in names(functional_network)) {
    analysis_data <- functional_network[[analysis_id]]
    if (!is.null(analysis_data$KEGG) && !is.null(analysis_data$GO)) {
      kegg_terms <- tolower(analysis_data$KEGG)
      go_terms <- tolower(analysis_data$GO)
      shared_keywords <- find_shared_biological_keywords(kegg_terms, go_terms)
      consistency_score <- length(shared_keywords) / 
        (length(unique(c(kegg_terms, go_terms))) + 0.001)
      consistency_scores <- c(consistency_scores, consistency_score)
      overlapping_analyses <- c(overlapping_analyses, analysis_id)
      if (consistency_score > 0.3) {
        cat("   高一致性分析:", analysis_id, "(得分:", round(consistency_score, 2), ")\n")
      }
    }
  }
  if (length(consistency_scores) > 0) {
    mean_consistency <- mean(consistency_scores)
    high_consistency_count <- sum(consistency_scores > 0.3)
    consistency_quality <- ifelse(mean_consistency > 0.4, "优秀",
                                  ifelse(mean_consistency > 0.2, "良好", "一般"))
  } else {
    mean_consistency <- 0
    high_consistency_count <- 0
    consistency_quality <- "无法评估"
  }
  consistency_results <- list(
    mean_consistency_score = mean_consistency,
    high_consistency_analyses = high_consistency_count,
    consistency_quality = consistency_quality,
    all_scores = data.frame(
      Analysis_ID = overlapping_analyses,
      Consistency_Score = consistency_scores,
      stringsAsFactors = FALSE
    )
  )
  cat("   跨方法一致性分析完成:\n")
  cat("     - 平均一致性得分:", round(mean_consistency, 3), "\n")
  cat("     - 高一致性分析数:", high_consistency_count, "\n")
  cat("     - 总体一致性质量:", consistency_quality, "\n")
  return(consistency_results)
}

### 4.16 高置信度功能模块识别函数
identify_high_confidence_modules <- function(kegg_integrated, go_results, consistency_analysis) {
  high_confidence_modules <- list()
  pathway_frequency <- table(kegg_integrated$Description)
  frequent_pathways <- names(pathway_frequency)[pathway_frequency >= 2]
  high_consistency_analyses <- consistency_analysis$all_scores[
    consistency_analysis$all_scores$Consistency_Score > 0.3, "Analysis_ID"]
  for (pathway in frequent_pathways) {
    pathway_data <- kegg_integrated[kegg_integrated$Description == pathway, ]
    module_confidence <- list(
      pathway_name = pathway,
      occurrence_count = nrow(pathway_data),
      mean_pvalue = mean(pathway_data$pvalue),
      min_pvalue = min(pathway_data$pvalue),
      associated_analyses = unique(pathway_data$Analysis_ID),
      high_consistency_analyses = sum(unique(pathway_data$Analysis_ID) %in% high_consistency_analyses),
      confidence_score = calculate_module_confidence(pathway_data, consistency_analysis)
    )
    module_confidence$go_associations <- find_related_go_terms(pathway, go_results)
    if (module_confidence$confidence_score > 0.6) {
      high_confidence_modules[[pathway]] <- module_confidence
    }
  }
  cat("   识别高置信度功能模块:", length(high_confidence_modules), "个\n")
  if (length(high_confidence_modules) > 0) {
    cat("   顶级高置信度模块:\n")
    module_scores <- sapply(high_confidence_modules, function(x) x$confidence_score)
    top_modules <- names(sort(module_scores, decreasing = TRUE))[1:min(3, length(module_scores))]
    for (module in top_modules) {
      cat("     - ", module, " (置信度:", 
          round(high_confidence_modules[[module]]$confidence_score, 2), ")\n", sep="")
    }
  }
  return(high_confidence_modules)
}

### 4.17 目标性状相关通路识别函数
identify_trait_related_pathways <- function(kegg_processing_results) {
  cat("\n=== 目标性状相关通路识别 ===\n")
  kegg_integrated <- kegg_processing_results$processed_results$integrated_results
  trait_keywords <- c(
    "neuro", "neuron", "synap", "dopamine", "glutamate", "GABA",
    "memory", "learn", "cognit", "behavior", "reward", "motivat",
    "circadian", "rhythm", "stress", "anxiety", "feed", "energy"
  )
  trait_related <- data.frame()
  for (keyword in trait_keywords) {
    matches <- grepl(keyword, kegg_integrated$Description, ignore.case = TRUE)
    if (any(matches)) {
      keyword_matches <- kegg_integrated[matches, ]
      trait_related <- rbind(trait_related, keyword_matches)
    }
  }
  trait_related <- trait_related[!duplicated(trait_related$ID), ]
  trait_related <- trait_related[order(trait_related$pvalue), ]
  pathway_categories <- categorize_trait_pathways(trait_related)
  trait_analysis <- list(
    related_pathways = trait_related,
    pathway_categories = pathway_categories,
    total_related_pathways = nrow(trait_related),
    top_pathways = head(trait_related, 5)
  )
  cat("   识别目标性状相关通路:", nrow(trait_related), "个\n")
  cat("   通路分类:\n")
  for (category in names(pathway_categories)) {
    cat("     - ", category, ": ", pathway_categories[[category]], "个通路\n", sep="")
  }
  return(trait_analysis)
}

### 4.18 通路网络关联分析函数
analyze_pathway_network <- function(trait_analysis, kegg_processing_results) {
  cat("\n=== 通路网络关联分析 ===\n")
  pathway_network <- list()
  related_pathways <- trait_analysis$related_pathways
  predefined_network <- list(
    "Neuroactive ligand-receptor interaction" = c("cAMP signaling pathway", "Calcium signaling pathway"),
    "cAMP signaling pathway" = c("Circadian entrainment", "Dopaminergic synapse"),
    "Calcium signaling pathway" = c("Glutamatergic synapse", "GABAergic synapse"),
    "Circadian entrainment" = c("Feeding behavior", "Energy metabolism")
  )
  network_connections <- data.frame()
  for (pathway in related_pathways$Description) {
    if (pathway %in% names(predefined_network)) {
      connected_pathways <- predefined_network[[pathway]]
      for (connected in connected_pathways) {
        if (connected %in% related_pathways$Description) {
          network_connections <- rbind(network_connections, 
                                       data.frame(From = pathway, To = connected))
        }
      }
    }
  }
  network_metrics <- list(
    total_nodes = length(unique(c(network_connections$From, network_connections$To))),
    total_edges = nrow(network_connections),
    network_density = ifelse(nrow(network_connections) > 0, 
                             2 * nrow(network_connections) / (length(unique(c(network_connections$From, network_connections$To))) * (length(unique(c(network_connections$From, network_connections$To))) - 1)), 0),
    connected_components = calculate_connected_components(network_connections)
  )
  pathway_network <- list(
    connections = network_connections,
    metrics = network_metrics,
    hub_pathways = identify_network_hubs(network_connections)
  )
  cat("   通路网络分析完成:\n")
  cat("     - 网络节点:", pathway_network$metrics$total_nodes, "个通路\n")
  cat("     - 网络连接:", pathway_network$metrics$total_edges, "条边\n")
  cat("     - 网络密度:", round(pathway_network$metrics$network_density, 3), "\n")
  cat("     - 枢纽通路:", length(pathway_network$hub_pathways), "个\n")
  return(pathway_network)
}

