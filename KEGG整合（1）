determine_kegg_organism <- function(kegg_ids) {
  k_format <- sum(grepl("^K[0-9]+$", kegg_ids))
  ko_format <- sum(grepl("^ko[0-9]+$", kegg_ids))
  numeric_format <- sum(grepl("^[0-9]+$", kegg_ids))
  cat("  KEGG ID格式统计: K格式=", k_format, 
      ", ko格式=", ko_format, 
      ", 数字格式=", numeric_format, "\n")
  if (k_format > 0 || ko_format > 0) {
    return(list(organism = "ko", keyType = "kegg"))
  } else if (numeric_format > 0) {
    return(list(organism = "ko", keyType = "kegg"))
  } else {
    return(list(organism = "ko", keyType = "kegg"))
  }
}

