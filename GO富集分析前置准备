execute_new_pipeline_data_preparation <- function() {
  cat("=== 开始执行新流程数据准备 ===\n")
  cat("基于DESeq2→趋势分析→WGCNA流程准备功能富集分析输入\n\n")
  cat("步骤1/6: 创建基因ID映射表\n")
  mapping_table <- create_gene_mapping_for_new_pipeline()
  cat("\n步骤2/6: 读取趋势分析基因列表\n")
  trend_lists <- read_trend_analysis_genes(mapping_table)
  cat("\n步骤3/6: 读取WGCNA网络分析基因列表\n")
  wgcna_lists <- read_wgcna_analysis_genes(mapping_table)
  cat("\n步骤4/6: 创建高置信度整合基因集合\n")
  integrated_lists <- create_integrated_gene_sets(trend_lists, wgcna_lists)
  cat("\n步骤5/6: 执行数据质量检查\n")
  quality_ok <- validate_data_quality(trend_lists, wgcna_lists, integrated_lists, mapping_table)
  cat("\n步骤6/6: 生成详细汇总报告\n")
  summary_report <- generate_comprehensive_summary(trend_lists, wgcna_lists, integrated_lists)
  all_gene_lists <- c(trend_lists, wgcna_lists, integrated_lists)
  saveRDS(all_gene_lists, "new_pipeline_processed_gene_lists.rds")
  cat("✅ 新流程基因列表已保存\n")
  return(list(
    mapping_table = mapping_table,
    trend_lists = trend_lists,
    wgcna_lists = wgcna_lists, 
    integrated_lists = integrated_lists,
    all_gene_lists = all_gene_lists,
    summary_report = summary_report,
    quality_ok = quality_ok
  ))
}

